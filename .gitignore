# Secrets and credentials — nothing of this shape belongs in a compliance repository
*.pem
*.key
*.p12
*.pfx
.env
.env.*
credentials
credentials.*
*_token
*.token

# Real control state. This repository ships mappings and validators, never evidence.
# `evidence_in_repo: none` is load-bearing, and this rule is what keeps it true.
evidence/
*.state.yaml
!04-evidence-and-audit/data/examples/*.state.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
